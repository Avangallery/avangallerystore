{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "avan-gallery",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "avan-gallery-db",
    "database_id": "PASTE_D1_DATABASE_ID_HERE"
  }],
  "r2_buckets": [{
    "binding": "IMAGES",
    "bucket_name": "avan-gallery-images"
  }]
}